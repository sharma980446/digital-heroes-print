# Use the loopback demo or a dedicated Supabase project.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000

# Hosted mode uses APP_MODE=hosted, HTTPS and the values below.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used by npm run seed:hosted after the account is confirmed in Supabase Auth.
SEED_STAFF_EMAIL=

# Order emails use these settings on the hosted worker.
# Configure signup confirmation separately in Supabase Auth SMTP settings.
RESEND_API_KEY=
EMAIL_FROM=
