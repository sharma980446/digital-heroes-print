{
  "name": "digital-heroes-print",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-acceptance.ts",
    "seed:hosted": "node --env-file-if-exists=.env.local --import tsx scripts/seed-hosted.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@fontsource-variable/manrope": "5.3.0",
