    "@hyzyla/pdfium": "^2.1.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.95.0",
    "@xmldom/xmldom": "^0.9.10",
    "csv-parse": "^6.1.0",
    "fflate": "^0.8.2",
    "fontkit": "^2.0.4",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "stripe": "^20.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.58.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
